{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "XTreamium Proxy"
    }
  },
  "Recordings": {
    "Path": "/home/fergalm/working/xtreamium/recordings"
  },
  "Tools": {
    "VideoPlayer": {
      "Executable": "/usr/bin/mpv",
      "Arguments": "--no-border --ontop --screen=2 --cache=yes --demuxer-max-bytes=5GiB --demuxer-max-back-bytes=5GiB  {{URL}}"
    }
  }
}
