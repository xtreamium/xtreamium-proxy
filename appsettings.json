{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/applog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "ApplicationName": "XTreamium Proxy"
    }
  },
  "App": {
    "VideoPlayer": {
      "Executable": "/usr/bin/mpv",
      "DefaultArguments": "--no-border --ontop --screen=2 --cache=yes --demuxer-max-bytes=5GiB --demuxer-max-back-bytes=5GiB {{URL}}"
    },
    "Recordings": {
      "MinDurationMinutes": 1,
      "MaxDurationMinutes": 600
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://streams.dev.fergl.ie:3000",
      "https://streams.fergl.ie",
      "https://streams.ferg.al"
    ]
  },
  "UpdateUrl": "https://github.com/xtreamium/xtreamium-proxy"
}
