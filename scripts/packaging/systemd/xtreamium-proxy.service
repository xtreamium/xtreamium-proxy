[Unit]
Description=Xtreamium Proxy Service
Documentation=https://github.com/xtreamium/xtreamium-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=xtreamium-proxy
Group=xtreamium-proxy

# Working directory
WorkingDirectory=/var/lib/xtreamium-proxy

# Application configuration
Environment="ASPNETCORE_ENVIRONMENT=Production"
Environment="DOTNET_PRINT_TELEMETRY_MESSAGE=false"

# Executable
ExecStart=/opt/xtreamium-proxy/xtreamium-proxy \
  --contentRoot /opt/xtreamium-proxy

# Restart policy
Restart=on-failure
RestartSec=10
KillMode=process
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xtreamium-proxy

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xtreamium-proxy /var/log/xtreamium-proxy /etc/xtreamium-proxy

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
