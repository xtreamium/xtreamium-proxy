<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Xtreamium.Proxy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.4.29</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>scripts/packaging/branding/app-icon.ico</ApplicationIcon>
    <Product>Xtreamium Proxy</Product>
    <Company>Xtreamium</Company>
    <Copyright>Copyright © Xtreamium 2025</Copyright>
    <Description>Xtreamium Proxy Service</Description>
  </PropertyGroup>

  <!-- Define WINDOWS constant when building/publishing for Windows -->
  <PropertyGroup Condition="$(RuntimeIdentifier.Contains('win'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <!-- Also define WINDOWS when OS is Windows and no specific RID is set -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' AND '$(RuntimeIdentifier)' == ''">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrystalQuartz.AspNetCore" Version="7.3.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Dapper.Contrib" Version="2.0.78" />
    <PackageReference Include="FFMpegCore" Version="5.2.0" />
    <PackageReference Include="FluentMigrator.Runner" Version="7.1.0" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Quartz" Version="3.15.0" />
    <PackageReference Include="Quartz.AspNetCore" Version="3.15.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.0" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.15.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="0.0.942" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\quartz.sql" />
    <None Remove="Data\xtreamium.sql" />
    <EmbeddedResource Include="Data\quartz.sql" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <None Include=".krud\.gitignore" />
    <None Include=".krud\.SRCINFO" />
    <None Include=".krud\PKGBUILD" />
    <None Include=".krud\update-sha.sh" />
    <None Include=".krud\xtreamium-proxy-1.3.0.tar.gz" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Compile Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="logs\**" />
    <Content Remove="publish\**" />
    <Content Include=".github\workflows\build-installers.yaml" />
  </ItemGroup>

  <!-- Simplified: Exclude entire publish and logs directories -->
  <ItemGroup>
    <Content Remove="publish/**" />
    <Compile Remove="publish/**" />
    <EmbeddedResource Remove="publish/**" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="pkg\xtreamium-proxy\opt\xtreamium-proxy\appsettings.json" />
    <_ContentIncludedByDefault Remove="pkg\xtreamium-proxy\opt\xtreamium-proxy\global.json" />
    <_ContentIncludedByDefault Remove="pkg\xtreamium-proxy\opt\xtreamium-proxy\xtreamium-proxy.staticwebassets.endpoints.json" />
    <_ContentIncludedByDefault Remove="src\appsettings.json" />
    <_ContentIncludedByDefault Remove="src\global.json" />
    <_ContentIncludedByDefault Remove="src\xtreamium-proxy.staticwebassets.endpoints.json" />
  </ItemGroup>

</Project>
